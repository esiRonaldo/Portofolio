# Copy this file to .env.local (ignored by Git) and fill in your own values.
# Restart `npm run dev` after changing it: Vite reads .env files only at startup.
# VITE_ values end up in the public JavaScript, so never put secrets here.

# Formspree form endpoint for the contact form (formspree.io → your form → "Integration").
# Leave it out and the form only shows a "sending isn't connected yet" note.
VITE_CONTACT_ENDPOINT=https://formspree.io/f/your-form-id
